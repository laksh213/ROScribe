# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Anthropic (the analysis brain)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Open-source models (downloaded locally on first run)
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Local storage — zero-config, just file paths (no DB server)
SQLITE_PATH=data/roscribe.db
CHROMA_DIR=data/chroma

# OCR languages for Tesseract: English + Sinhala + Tamil
TESSERACT_LANGS=eng+sin+tam
